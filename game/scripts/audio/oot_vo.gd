class_name OOTVoiceLines
extends RefCounted
## Looks up placeholder (and later, final) voice-over for a story line.
## Line ids are "<scene_id>_<NNN>" where NNN is the line's index in its scene
## (the Name column of data/story/pN_lines.csv). Missing audio is not an error:
## get_stream() returns null and the line plays silently.
## Placeholder VO is generated by tools/voice/gen_placeholder_vo.py and is never shipped.

const VO_ROOT: String = "res://audio/vo_placeholder"
const DEFAULT_PART: String = "p1"
const VO_BUS: StringName = &"VO"

static var _cache: Dictionary = {}


static func make_id(scene_id: String, order: int) -> String:
	return "%s_%03d" % [scene_id, order]


static func stream_path(line_id: String, part_id: String = DEFAULT_PART) -> String:
	return "%s/%s/%s.ogg" % [VO_ROOT, part_id, line_id]


static func lip_path(line_id: String, part_id: String = DEFAULT_PART) -> String:
	return "%s/%s/%s.lip.json" % [VO_ROOT, part_id, line_id]


static func has_stream(line_id: String, part_id: String = DEFAULT_PART) -> bool:
	return not line_id.is_empty() and ResourceLoader.exists(stream_path(line_id, part_id))


## The VO stream for a line id, or null when none exists.
static func get_stream(line_id: String, part_id: String = DEFAULT_PART) -> AudioStream:
	if line_id.is_empty():
		return null
	var path: String = stream_path(line_id, part_id)
	if not ResourceLoader.exists(path):
		return null
	return load(path) as AudioStream


## Mouth cues as an Array of {start, end, value} (value A-H or X), empty when absent.
static func get_lip_cues(line_id: String, part_id: String = DEFAULT_PART) -> Array:
	var path: String = lip_path(line_id, part_id)
	if _cache.has(path):
		return _cache[path]
	var cues: Array = []
	if FileAccess.file_exists(path):
		var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(path))
		if parsed is Dictionary and (parsed as Dictionary).get("mouthCues") is Array:
			cues = (parsed as Dictionary)["mouthCues"]
	_cache[path] = cues
	return cues


## Mouth shape (A-H, X) at time t seconds into the line.
static func mouth_at(cues: Array, t: float) -> String:
	for c: Variant in cues:
		var d: Dictionary = c
		if t >= float(d["start"]) and t < float(d["end"]):
			return str(d["value"])
	return "X"
